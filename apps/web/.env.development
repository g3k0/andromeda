# Local development (loaded automatically by `next dev`).
# Next.js sets NODE_ENV=development when this file is used.
# Non-secret defaults only — credentials go in `.env.local` or `.env.development.local` (gitignored).

NEXT_PUBLIC_CHAIN=amoy

# Alchemy Amoy RPC — set real URLs in `.env.local` (gitignored), e.g.:
# ALCHEMY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/<KEY>
# NEXT_PUBLIC_ALCHEMY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/<KEY>

# Permanent storage (default arweave — see .env.example):
# PERMANENT_STORAGE_BACKEND=arweave
# ARWEAVE_JWK=…                 # server-only Turbo auth for local publish
# ARWEAVE_GATEWAY_URLS=https://arweave.net,https://ar-io.net
# IPFS_* vars are legacy (dual-read / opt-in pinata writes only).
