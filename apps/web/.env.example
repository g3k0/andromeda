# Copy to `.env.local` for local secrets (gitignored):
#   cp apps/web/.env.example apps/web/.env.local
#
# Next.js loads environment files by NODE_ENV:
#   local development → `next dev` (NODE_ENV=development) → `.env.development` + `.env.local`
#   production        → `next build` / `next start` (NODE_ENV=production) → `.env.production` + `.env.production.local`
#   tests             → Vitest (NODE_ENV=test) → `.env.test`
#
# If NODE_ENV is unset, `next dev` defaults to development (local).
# Never commit real credentials to the repository.

# Public chain configuration (exposed to the browser)
# Target chain: "polygon" (mainnet) or "amoy" (testnet)
NEXT_PUBLIC_CHAIN=amoy

# Canonical site origin for metadata, sitemap, and hreflang (no trailing slash)
# Example production value: https://andromeda-bookstore.xyz
NEXT_PUBLIC_SITE_URL=

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed Andromeda ERC-721 contract address
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ERC-6551 Tokenbound registry and account proxy (defaults: Tokenbound v0.3.1 canonical addresses)
# Override on Amoy if the registry is not yet deployed on your testnet instance.
NEXT_PUBLIC_ERC6551_REGISTRY=
NEXT_PUBLIC_ERC6551_IMPLEMENTATION=

# Alchemy Polygon JSON-RPC (https://www.alchemy.com/)
# Server: indexer, public client, read-access. Client: wagmi wallet reads/writes.
# Use separate Alchemy apps for Amoy (dev) and mainnet (production); rotate keys in dashboard.
ALCHEMY_RPC_URL=
NEXT_PUBLIC_ALCHEMY_RPC_URL=

# Comma-separated admin wallets (server-only; preferred over NEXT_PUBLIC_*)
ADMIN_ADDRESSES=

# Legacy client-exposed admin list — deprecated, use ADMIN_ADDRESSES + users collection
NEXT_PUBLIC_ADMIN_ADDRESSES=

# MongoDB connection string (server-only, never prefix with NEXT_PUBLIC_)
MONGODB_URI=mongodb://<user>:<password>@127.0.0.1:27017/andromeda?authSource=andromeda

# Trust X-Forwarded-For / X-Real-IP when behind a reverse proxy (server-only)
TRUST_PROXY=false

# Auth and rate-limit tuning (server-only, optional — defaults in src/lib/config/auth.ts)
# WALLET_SESSION_TTL_MINUTES=15
# WALLET_BINDING_TTL_HOURS=24
# WALLET_AUTH_NONCE_TTL_MINUTES=5
# RATE_LIMIT_MAX_REQUESTS=30
# RATE_LIMIT_WINDOW_MS=60000
# AUTH_MESSAGE_RATE_LIMIT=10
# WORK_UPLOAD_IP_RATE_LIMIT_MAX_REQUESTS=10
# WORK_UPLOAD_IP_RATE_LIMIT_WINDOW_MS=60000
# WORK_UPLOAD_WALLET_RATE_LIMIT_MAX_REQUESTS=5
# WORK_UPLOAD_WALLET_RATE_LIMIT_WINDOW_MS=3600000

# Permanent storage backend for work publish uploads:
# - Preview / local cutover: "arweave" (requires ARWEAVE_JWK + Turbo credits)
# - Production until full cutover: keep "pinata" (legacy)
PERMANENT_STORAGE_BACKEND=pinata

# IPFS pinning (server-only) and gateway — used while PERMANENT_STORAGE_BACKEND=pinata
IPFS_PINNING_API_KEY=
IPFS_GATEWAY_BASE_URL=
NEXT_PUBLIC_IPFS_GATEWAY_BASE_URL=

# Arweave Turbo auth (server-only). Required when PERMANENT_STORAGE_BACKEND=arweave.
# Paste the full JWK JSON on one line (never commit real keys).
ARWEAVE_JWK=
# Alias accepted by the factory:
# ARWEAVE_TURBO_JWK=

# Arweave gateways (read path for ar:// URIs)
# Prefer a comma-separated failover list; first entry is primary for display URLs.
# ARWEAVE_GATEWAY_URLS=https://arweave.net,https://ar-io.net
ARWEAVE_GATEWAY_URLS=
# Fallback when ARWEAVE_GATEWAY_URLS is empty (still combined with public defaults):
ARWEAVE_GATEWAY_BASE_URL=
NEXT_PUBLIC_ARWEAVE_GATEWAY_BASE_URL=
# Optional public mirror of the failover list for client-side reads:
# NEXT_PUBLIC_ARWEAVE_GATEWAY_URLS=
