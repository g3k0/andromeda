# Copy to `.env.local` for local secrets and overrides (gitignored).
# Next.js loads environment files by NODE_ENV:
#   local development → `next dev` (NODE_ENV=development) → `.env.development` + `.env.local`
#   production        → `next build` / `next start` (NODE_ENV=production) → `.env.production` + `.env.production.local`
#   tests             → Vitest (NODE_ENV=test) → `.env.test`
#
# If NODE_ENV is unset, `next dev` defaults to development (local).

# Public chain configuration (exposed to the browser)
# Target chain: "polygon" (mainnet) or "amoy" (testnet)
NEXT_PUBLIC_CHAIN=amoy

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed Andromeda ERC-721 contract address
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Comma-separated list of wallet addresses allowed into the /admin area
NEXT_PUBLIC_ADMIN_ADDRESSES=

# MongoDB connection string (server-only, never prefix with NEXT_PUBLIC_)
MONGODB_URI=mongodb://127.0.0.1:27017/andromeda
