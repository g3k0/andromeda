# Production (loaded automatically by `next build` and `next start`).
# Next.js sets NODE_ENV=production when this file is used.
# Set secrets in the deployment platform or in `.env.production.local` (gitignored).

NEXT_PUBLIC_CHAIN=polygon

# Alchemy Polygon mainnet RPC — set in Vercel or `.env.production.local`, e.g.:
# ALCHEMY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/<KEY>
# NEXT_PUBLIC_ALCHEMY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/<KEY>

# Permanent storage (Production cutover — PR9):
# PERMANENT_STORAGE_BACKEND=arweave
# ARWEAVE_JWK=…                 # server-only Turbo auth (required for publish)
# ARWEAVE_GATEWAY_URLS=https://arweave.net,https://ar-io.net
# IPFS_PINNING_API_KEY is NOT required for Production writes (legacy / dual-read only).
