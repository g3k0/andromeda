{
  "name": "andromeda",
  "version": "0.41.0",
  "description": "A blockchain platform that empowers writers to share and sell their work as author-certified NFT copies.",
  "keywords": [
    "andromeda",
    "blockchain",
    "decentralized-publishing",
    "erc-721",
    "hardhat",
    "arweave",
    "monorepo",
    "nextjs",
    "nft",
    "polygon",
    "publishing",
    "typescript",
    "web3",
    "writers"
  ],
  "homepage": "https://andromeda-bookstore.xyz/",
  "bugs": {
    "url": "https://github.com/g3k0/andromeda/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g3k0/andromeda.git",
    "directory": "."
  },
  "license": "MIT",
  "author": "Christian Palazzo <palazzochristian@yahoo.it>",
  "contributors": [],
  "private": false,
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": "20.x",
    "pnpm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @andromeda/web dev",
    "build": "pnpm --filter @andromeda/web build",
    "start": "pnpm --filter @andromeda/web start",
    "lint": "pnpm --filter @andromeda/web lint",
    "lint:fix": "pnpm --filter @andromeda/web lint:fix",
    "typecheck": "pnpm --filter @andromeda/web typecheck",
    "react-doctor:scan": "pnpm --filter @andromeda/web react-doctor:scan",
    "react-doctor:ci": "pnpm --filter @andromeda/web react-doctor:ci",
    "web:test": "pnpm --filter @andromeda/web test",
    "web:test:coverage": "pnpm --filter @andromeda/web test:coverage",
    "web:i18n:check-keys": "pnpm --filter @andromeda/web i18n:check-keys",
    "contracts:build": "pnpm --filter @andromeda/contracts build",
    "contracts:test": "pnpm --filter @andromeda/contracts test",
    "contracts:deploy:amoy": "pnpm --filter @andromeda/contracts deploy:amoy"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.0"
    }
  }
}
